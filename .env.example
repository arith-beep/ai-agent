# Postgres (Docker Compose defaults shown for local dev).
# In production (e.g. Supabase), use the connection pooler (port 6543,
# "Transaction" mode) and append ?sslmode=require&pgbouncer=true — see
# DEPLOYMENT.md. A direct connection (port 5432) also works but doesn't
# scale under serverless (each invocation can open its own connection).
DATABASE_URL=postgres://ai_agent:ai_agent@localhost:5432/ai_agent

# Redis (BullMQ + realtime pub/sub). OPTIONAL in production: only the URL
# knowledge-source ingestion path needs it. Leave unset to run without a
# queue/worker — Website URL knowledge sources are then honestly disabled
# in the UI rather than silently failing; text/PDF knowledge, chat, tool
# calling, lead capture and meeting booking all work with no queue at all.
REDIS_URL=redis://localhost:6379

# App-level secret used to derive the AES-256-GCM key that encrypts
# model provider API keys and tool credentials at rest. Generate with:
#   openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# Auth (NextAuth v5). Generate AUTH_SECRET with: openssl rand -base64 32
# AUTH_URL is optional on Vercel (NextAuth trusts the Vercel-provided host
# automatically) but recommended: set it to your production URL.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Required in production for real LLM responses, agent generation, and
# embeddings (RAG). Per-organization credentials entered via Settings ->
# Models are preferred and override this; this is the fallback used when
# an org hasn't configured its own key yet.
OPENAI_API_KEY=

# Optional: only needed if you want a given provider available to agents.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
