# Postgres (Docker Compose defaults shown)
DATABASE_URL=postgres://ai_agent:ai_agent@localhost:5432/ai_agent

# Redis (BullMQ + realtime pub/sub)
REDIS_URL=redis://localhost:6379

# App-level secret used to derive the AES-256-GCM key that encrypts
# model provider API keys and tool credentials at rest. Generate with:
#   openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# Auth (NextAuth). Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Optional: only needed if you want a given provider available to agents.
# Per-organization credentials entered via the dashboard are preferred;
# these are only a fallback for local development.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
